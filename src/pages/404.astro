---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada">
    <section
        class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900"
    >
        <!-- Overlay decorativo -->
        <div class="absolute inset-0 bg-black/30 z-0"></div>

        <!-- Elementos decorativos de fondo -->
        <div class="absolute inset-0 overflow-hidden">
            <div
                class="absolute top-1/4 -right-1/4 w-[600px] h-[600px] bg-brand-500/20 rounded-full blur-3xl animate-pulse"
            >
            </div>
            <div
                class="absolute -bottom-1/4 -left-1/4 w-[500px] h-[500px] bg-brand-300/10 rounded-full blur-3xl animate-pulse"
                style="animation-delay: 1s;"
            >
            </div>
        </div>

        <!-- Contenido principal -->
        <div
            class="relative z-10 max-w-4xl mx-auto px-6 pt-32 md:pt-40 text-center"
        >
            <!-- Número 404 grande y animado -->
            <div class="mb-6">
                <h1
                    class="text-[8rem] md:text-[10rem] lg:text-[12rem] font-bold leading-none tracking-tighter"
                >
                    <span
                        class="bg-gradient-to-r from-brand-400 via-brand-200 to-brand-400 bg-clip-text text-transparent animate-gradient"
                    >
                        404
                    </span>
                </h1>
            </div>

            <!-- Icono de casa perdida -->
            <div class="mb-8 flex justify-center">
                <div
                    class="w-24 h-24 bg-gradient-to-br from-brand-400 to-brand-600 rounded-full flex items-center justify-center animate-bounce-slow"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-12 h-12 text-white"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205 3 1m1.5.5-1.5-.5M6.75 7.364V3h-3v18m3-13.636 10.5-3.819"
                        ></path>
                    </svg>
                </div>
            </div>

            <!-- Título y descripción -->
            <h2
                class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight"
            >
                ¡Oops! Página no encontrada
            </h2>

            <p
                class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-12 leading-relaxed"
            >
                Parece que esta página se mudó a otro lote. No te preocupes, te
                ayudamos a encontrar el camino de regreso.
            </p>

            <!-- Botones de acción -->
            <div
                class="flex flex-col sm:flex-row gap-4 justify-center items-center"
            >
                <a
                    href="/"
                    class="group flex items-center gap-2 px-8 py-4 bg-brand-500 text-white rounded-full font-semibold shadow-lg shadow-brand-500/30 hover:bg-brand-600 hover:shadow-xl hover:shadow-brand-600/40 transition-all duration-300 hover:scale-105"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5 group-hover:-translate-x-1 transition-transform duration-300"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
                    </svg>
                    Volver al inicio
                </a>

                <a
                    href="/proyectos"
                    class="flex items-center gap-2 px-8 py-4 bg-white/10 backdrop-blur-sm text-white rounded-full font-semibold border border-white/30 hover:bg-white hover:text-brand-900 transition-all duration-300 hover:scale-105"
                >
                    Ver proyectos
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-5 h-5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"
                        ></path>
                    </svg>
                </a>
            </div>

            <!-- Enlaces útiles -->
            <div class="mt-16 pt-8 border-t border-white/10">
                <p class="text-gray-400 text-sm mb-4">
                    También puedes visitar:
                </p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a
                        href="/sobre-nosotros"
                        class="text-brand-300 hover:text-brand-200 transition-colors duration-300 text-sm font-medium"
                    >
                        Sobre nosotros
                    </a>
                    <span class="text-gray-600">•</span>
                    <a
                        href="/contacto"
                        class="text-brand-300 hover:text-brand-200 transition-colors duration-300 text-sm font-medium"
                    >
                        Contacto
                    </a>
                </div>
            </div>
        </div>

        <!-- Partículas flotantes decorativas -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div
                class="particle absolute w-2 h-2 bg-brand-400/30 rounded-full"
                style="top: 20%; left: 10%; animation: float 6s ease-in-out infinite;"
            >
            </div>
            <div
                class="particle absolute w-3 h-3 bg-brand-300/20 rounded-full"
                style="top: 60%; left: 80%; animation: float 8s ease-in-out infinite 1s;"
            >
            </div>
            <div
                class="particle absolute w-2 h-2 bg-brand-500/25 rounded-full"
                style="top: 40%; left: 20%; animation: float 7s ease-in-out infinite 2s;"
            >
            </div>
            <div
                class="particle absolute w-4 h-4 bg-brand-200/15 rounded-full"
                style="top: 70%; left: 60%; animation: float 9s ease-in-out infinite 1.5s;"
            >
            </div>
        </div>
    </section>
</Layout>

<style>
    @keyframes float {
        0%,
        100% {
            transform: translateY(0) translateX(0);
        }
        25% {
            transform: translateY(-20px) translateX(10px);
        }
        50% {
            transform: translateY(-40px) translateX(-10px);
        }
        75% {
            transform: translateY(-20px) translateX(5px);
        }
    }

    @keyframes animate-gradient {
        0%,
        100% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
    }

    .animate-gradient {
        background-size: 200% auto;
        animation: animate-gradient 3s ease infinite;
    }

    .animate-bounce-slow {
        animation: bounce 3s ease-in-out infinite;
    }

    @keyframes bounce {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }
</style>
