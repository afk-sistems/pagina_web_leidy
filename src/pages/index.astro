		>
		</div>

		<div class="relative z-10 max-w-7xl mx-auto px-6">
			<div
				class="bg-white rounded-3xl p-12 md:p-20 shadow-2xl border border-gray-100 relative overflow-hidden"
			>
				<!-- Decorative elements -->
				<div
