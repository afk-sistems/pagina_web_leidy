				>
				</div>
				<div
					class="absolute bottom-0 left-0 w-96 h-96 bg-blue-50/50 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"
				>
				</div>

				<div
					class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-16"
				>
					<!-- Text Content -->
					<div class="text-center md:text-left max-w-2xl">
						<div
							class="inline-flex items-center gap-2 px-4 py-2 bg-brand-50 rounded-full text-brand-600 font-semibold text-sm mb-6 border border-brand-100"
						>
							<span
								class="w-2 h-2 bg-brand-500 rounded-full animate-pulse"
							></span>
							Certificación 2025
						</div>

						<h2
							class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight"
						>
							Excelencia Certificada <br />
							<span class="text-brand-500">ISO 9001</span>
						</h2>

						<p
							class="text-xl text-gray-600 mb-8 leading-relaxed text-justify"
						>
							Nos enorgullece anunciar nuestra certificación en
							gestión de calidad. Un reconocimiento a nuestro
							compromiso inquebrantable con la excelencia y la
							satisfacción de nuestros clientes.
						</p>

						<div
							class="flex flex-wrap gap-4 justify-center md:justify-start"
						>
							<div
								class="flex items-center gap-3 px-6 py-3 bg-gray-50 rounded-xl border border-gray-100"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-6 h-6 text-green-500"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									><path
										d="M22 11.08V12a10 10 0 1 1-5.93-9.14"
									></path><polyline
										points="22 4 12 14.01 9 11.01"
									></polyline></svg
								>
								<span class="font-medium text-gray-700"
									>Calidad Grantizada</span
								>
							</div>
							<div
								class="flex items-center gap-3 px-6 py-3 bg-gray-50 rounded-xl border border-gray-100"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-6 h-6 text-blue-500"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									><path
										d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
									></path></svg
								>
								<span class="font-medium text-gray-700"
									>Estándares Internacionales</span
								>
							</div>
						</div>
					</div>

					<!-- Logo Image -->
					<div class="relative group">
						<div
							class="absolute inset-0 bg-gradient-to-br from-brand-200 to-blue-200 rounded-full blur-2xl opacity-20 group-hover:opacity-40 transition-opacity duration-500"
						>
						</div>
						<div
							class="relative bg-white md:p-8 rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-gray-100"
						>
							<Image
								src={aenorLogo}
								alt="Certificación AENOR ISO 9001"
								class="w-64 h-auto md:w-80 object-contain drop-shadow-sm"
								width={400}
								height={400}
